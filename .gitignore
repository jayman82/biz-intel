# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local

# Claude Code
.claude/*
!.claude/settings.json

# Phase C LLM gate caches (per-artifact, machine-local; safe to delete).
# tools/presentations/gates/llm_router.py writes one cache per gate per
# artifact at <artifact>.llm-<gate>.json so re-runs are cheap and
# idempotent. They are NOT brand-curated content.
*.llm-*.json

# ── publish-check generated artifacts (macrofiche engine) ──
# print-screen-diff gate output — debug PNGs + manifest written next to the
# rendered artifact. Regeneratable; untracked orphans trip the dirty-tree
# precondition in bump-brand-pins.py and stall fleet pin-rolls.
*.print-diff/

# preview-capture-diff gate output — same shape, same failure mode.
*.preview-diff/

# FEAT-106 per-artifact quality certificate. Regenerated on every
# publish-check run against the artifact; safe to delete.
*.quality-cert.json

